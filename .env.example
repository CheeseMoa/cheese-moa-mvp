# 로컬 개발용 env 예시 — `cp .env.example .env.development` (이 파일 자체는 vite가 읽지 않는다)
# 프로덕션(Vercel)은 env 없이 빌드한다 — MSW는 꺼지고(main.tsx 엄격 비교),
# /api/v1 프록시·SPA 폴백은 vite 프록시 대신 vercel.json rewrite가 담당한다
# MSW 목 API 활성화 — FE가 BE 없이 목 데이터로 개발 (목이 실 BE 계약을 구현 — CHMO-195)
# 실 BE 연동 확인 시 false로 — /api/v1 요청이 vite 프록시를 타고 VITE_API_ORIGIN으로 전달된다
VITE_ENABLE_MSW=true

# 실 BE 오리진(vite dev 프록시 대상) — 미설정 시 https://api.cheese-moa.com (vite.config.ts 기본값)
# EC2 직통 IP(3.35.177.22)는 보안그룹이 Cloudflare 경유만 허용해 더는 접속 불가 (CHMO-260)
# VITE_API_ORIGIN=https://api.cheese-moa.com

# API 직통 모드 (CHMO-573) — 'true'면 /api/v1 상대경로 대신 VITE_API_ORIGIN을 직접 부른다.
# 개발환경(스테이징 BE)용 Vercel 프로젝트 전용: vercel.json rewrite는 프로젝트별로 가를 수 없어서
# env로 오리진을 정한다. 직통 호출은 CORS를 타므로 BE CORS_ALLOWED_ORIGINS에 이 FE 오리진이
# 있어야 하고, MSW와 함께 쓰지 않는다. 로컬 개발에선 켜지 말 것 — vite 프록시가 담당한다.
# VITE_API_DIRECT=true

# 사용자 행동 추적 (CHMO-660) — Amplitude API 키. **미설정이면 추적 전체가 no-op**이고
# 네트워크 요청이 0건이라, 키를 넣기 전까지 이 코드가 배포돼 있어도 무해하다.
# ⚠ 키를 넣는 순간 개인정보 처리방침 §11(자동 수집 장치)의 "쿠키 등 자동 식별 장치를
#   사용하지 않습니다"가 사실과 달라진다 — 키 투입 배포와 §11·§8(위탁)·§9(국외 이전)
#   개정 배포는 반드시 같이 나간다. 자세한 내용은 src/lib/analytics.ts 머리 주석.
# VITE_AMPLITUDE_API_KEY=
# Amplitude 프로젝트를 EU 리전으로 만든 경우에만 'EU' (기본 US — 안 맞으면 이벤트가 버려진다)
# VITE_AMPLITUDE_SERVER_ZONE=EU
